        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"festa\",uri!~\"/actuator.*\"}[1m]))",
          "refId": "A",
          "datasource": {
